{
  "ignorePatterns": ["dist", "build", "third_party", "node_modules", "fixtures"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["packages/wasm/**"],
      "rules": { "no-underscore-dangle": "off" }
    }
  ]
}
